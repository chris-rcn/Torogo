#!/bin/sh
# train-ppat-parallel — launch K train-ppat workers that pool their θ updates,
# plus one dedicated monitor that tests the combined checkpoint without stalling
# the trainers.
#
#   ./train-ppat-parallel <K> <data> [extra train-ppat args...]
#
# The K trainers run silently in the background; every --sync-every positions they
# file-barrier all-reduce the SUM of their θ displacements (not the mean, so --lr
# means the same at any worker count), and worker 0 writes the combined
# checkpoint.  The foreground process is the monitor: it repeatedly loads that
# checkpoint, runs the test, and prints the live |ΔV| table.  Because testing is
# off the training critical path, the trainers never wait on it.
#
# The checkpoint goes to --save PATH when given (with its -best twin beside it),
# else to out/ppat-data-<pid>.js.
#
# Example (10 trainers, sync every 2000 positions):
#   ./train-ppat-parallel 10 out/evals-s9-500k.txt --value-playouts 100 --gradient-playouts 100 --lr 5 \
#       --train-pos 24000 --test-pos 2000 --sync-every 2000
set -e
# Locate the binary by absolute path but keep the caller's cwd, so relative
# data/output paths (e.g. out/evals-s9-500k.txt, out/ppat-data-*.js) resolve.
BIN="$(cd "$(dirname "$0")" && pwd)/train-ppat"

# Usage text is the header comment above, so the two cannot drift apart.
usage() {
    awk 'NR == 1 && /^#!/ { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"
    exit "${1:-0}"
}
case "${1:-}" in
    -h|--help) usage 0 ;;
esac
if [ $# -lt 2 ]; then
    echo "train-ppat-parallel: need <K> and <data>" >&2
    echo >&2
    usage 1 >&2
fi

K="$1"; DATA="$2"; shift 2
RUN="$$"
SYNC_DIR="out/ppat-sync-$RUN"
# Honour an explicit --save (the trainer reads the FIRST --save it is given, so
# the wrapper must not add one of its own ahead of the user's).
SAVE=""; prev=""
for a in "$@"; do
    [ "$prev" = "--save" ] && { SAVE="$a"; break; }
    prev="$a"
done
if [ -n "$SAVE" ]; then
    CKPT="$SAVE"; SAVE_ARGS=""                     # already in "$@"
else
    CKPT="out/ppat-data-$RUN.js"; SAVE_ARGS="--save $CKPT"
fi

# The trainers' stdout goes to /dev/null (the monitor owns the terminal), so a
# seed chosen inside train-ppat would never be seen.  Choose it here instead, so
# a single-worker run can be replayed.  Honour an explicit --seed in the passed
# args rather than overriding it.
SEED=""; prev=""
for a in "$@"; do
    [ "$prev" = "--seed" ] && { SEED="$a"; break; }
    prev="$a"
done
if [ -n "$SEED" ]; then
    SEED_ARGS=""                                   # already in "$@"
    # The sync barrier's poll loop draws from the same RNG, so with K > 1
    # wall-clock timing perturbs the training stream whatever the seed.
    [ "$K" -gt 1 ] && echo "WARNING: --seed does not make a parallel run reproducible — the sync
         barrier's poll loop draws from the same RNG, so wall-clock
         timing perturbs the training stream.  Use K = 1." >&2
else
    SEED=$(( ($(date +%s) + $$ * 7919) % 2147483647 ))
    SEED_ARGS="--seed $SEED"
fi

# Fresh sync dir (avoid stale round files from a previous run).
rm -rf "$SYNC_DIR"; mkdir -p "$SYNC_DIR"

# The binary's monitor prints the whole shared banner (data / model / match /
# out); the wrapper adds only the seed, which the workers (stdout to /dev/null;
# stderr kept, so their warnings and errors reach the terminal)
# cannot report and which is replayable only at K=1.
[ "$K" -eq 1 ] && echo "seed      $SEED  (replay with --seed $SEED)"
PIDS=""
i=0
while [ "$i" -lt "$K" ]; do
    "$BIN" "$DATA" --workers "$K" --worker-id "$i" --sync-dir "$SYNC_DIR" $SAVE_ARGS $SEED_ARGS "$@" >/dev/null &
    PIDS="$PIDS $!"
    i=$((i + 1))
done

# Kill all trainers if the monitor exits (Ctrl-C, etc.); leave the checkpoint.
trap 'kill $PIDS 2>/dev/null; rm -rf "$SYNC_DIR"' INT TERM EXIT

# Monitor in the foreground: tests the combined checkpoint and prints the table.
# It gets the test args from "$@" (test-pos/test-playouts/test-moves/phases) and
# --workers so it can report aggregate positions; it ignores the training args.
"$BIN" "$DATA" --workers "$K" --monitor "$CKPT" "$@"
